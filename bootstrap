#!/usr/bin/env bash
# ; exec pwsh -NoProfile -ExecutionPolicy Bypass -File "${BASH_SOURCE[0]}" "$@"
set -euo pipefail

# determine where this script lives
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

DRY_RUN=false
for arg in "$@"; do
  [[ $arg == --dry-run ]] && DRY_RUN=true
done

if [ -n "${BASH_VERSION:-}" ]; then
  # Unix branch: dispatch based on OS
  case "$(uname -s)" in
    Darwin)
      bash "$SCRIPT_DIR/scripts/setup-macos.sh" "$@"
      ;;
    Linux)
      bash "$SCRIPT_DIR/scripts/setup-linux.sh" "$@"
      ;;
    *)
      echo "Error, unsupported OS: $(uname -s)" >&2
      exit 1
      ;;
  esac

  CHEZMOI_SOURCE="$SCRIPT_DIR/dotfiles"
  if command -v chezmoi >/dev/null 2>&1; then
    if [ "$DRY_RUN" = true ]; then
      echo "🧪 [dry-run] applying dotfiles with chezmoi"
      chezmoi init --source="$CHEZMOI_SOURCE" >/dev/null 2>&1 || true
      chezmoi apply --source="$CHEZMOI_SOURCE" --dry-run
    else
      echo "📁 Applying dotfiles with chezmoi"
      chezmoi init --source="$CHEZMOI_SOURCE" >/dev/null 2>&1 || true
      chezmoi apply --source="$CHEZMOI_SOURCE"
    fi
  else
    echo "⚠️ chezmoi not found; skipping dotfiles"
  fi
  exit 0
fi

# PowerShell branch (Windows)
Write-Host "Detected PowerShell environment..."
pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/scripts/setup-windows.ps1" @args
